# ── Folders not related to the app ──
others/
generated_4096/
generation/
results/

# ── Tool output (generated at runtime) ──
tool/output/
tool/data/

# ── Trained model binaries (large files, regenerate via training) ──
tool/models/*.pkl

# ── Excel / CSV data files ──
*.xlsx
*.xls
*.csv

# ── Temp / lock files ──
~$*
*.zip
*.log

# ── Python cache ──
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments ──
venv/
.venv/
env/
.env

# ── IDE / OS files ──
.vscode/
.idea/
*.DS_Store
Thumbs.db

# ── Pytest / coverage ──
.pytest_cache/
.coverage
htmlcov/
