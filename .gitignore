# ── Unrelated folders ──
others/
generated_4096/
generation/
results/

# ── tool/output: runtime-generated plots and Excel files ──
tool/output/*.png
tool/output/intermediate/
tool/output/gpr/
tool/output/linear/
tool/output/rf/
tool/output/xgboost/

# ── tool/models: trained model binaries (large, regenerated by training) ──
tool/models/*.pkl

# ── tool/data: raw input/training data files ──
tool/data/

# ── Excel / CSV data files in root ──
*.xlsx
*.xls
*.csv
~$*

# ── Backup ──
*.zip

# ── Python cache ──
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── Virtual environments ──
venv/
.venv/
env/
.env

# ── IDE / OS files ──
.vscode/
.idea/
*.DS_Store
Thumbs.db

# ── Pytest / coverage ──
.pytest_cache/
.coverage
htmlcov/
